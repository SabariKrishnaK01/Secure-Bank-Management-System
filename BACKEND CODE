    private static void viewRecords() {
        System.out.println("\n=== Bank Records ===");
        
        System.out.println("\n--- Customers ---");
        if (customers.isEmpty()) {
            System.out.println("No customers registered.");
        } else {
            customers.forEach(c -> {
                System.out.println("ID: " + c.getId() + " | Name: " + c.getName() + 
                                 " | Phone: " + c.getPhone() + " | Joined: " + c.getJoinDate());
            });
        }
        
        System.out.println("\n--- Accounts ---");
        if (accounts.isEmpty()) {
            System.out.println("No accounts opened.");
        } else {
            accounts.forEach(a -> {
                Customer customer = customers.stream()
                                          .filter(c -> c.getId() == a.getCustomerId())
                                          .findFirst()
                                          .orElse(null);
                String customerName = customer != null ? customer.getName() : "Unknown";
                
                System.out.printf("A/C No: %d | Type: %s | Customer: %s (ID: %d) | Balance: ₹%.2f | Interest: %.2f%%%n",
                                a.getId(), a.getType(), customerName, a.getCustomerId(), 
                                a.getBalance(), a.getInterestRate());
                if (a.getFdMaturity() != null) {
                    System.out.println("  Fixed Deposit Matures on: " + a.getFdMaturity());
                }
            });
        }
        
        System.out.println("\n--- Recent Transactions (Last 50) ---");
        if (transactions.isEmpty()) {
            System.out.println("No transactions processed.");
        } else {
            transactions.stream()
                      .sorted((t1, t2) -> Integer.compare(t2.getId(), t1.getId())) // Descending order
                      .limit(50)
                      .forEach(t -> {
                          System.out.printf("Txn ID: %d | A/C: %d | Type: %s | Amount: ₹%.2f | Balance: ₹%.2f | Date: %s%n",
                                          t.getId(), t.getAccountId(), t.getType(), 
                                          t.getAmount(), t.getBalance(), t.getDate());
                          System.out.println("  Remarks: " + t.getRemarks());
                      });
        }
        
        System.out.println("\n--- Loans ---");
        if (loans.isEmpty()) {
            System.out.println("No loan applications.");
        } else {
            loans.forEach(l -> {
                Customer customer = customers.stream()
                                          .filter(c -> c.getId() == l.getCustomerId())
                                          .findFirst()
                                          .orElse(null);
                String customerName = customer != null ? customer.getName() : "Unknown";
                
                System.out.printf("Loan ID: %d | Type: %s | Customer: %s (ID: %d) | Amount: ₹%.2f | Interest: %.2f%%%n",
                                l.getId(), l.getType(), customerName, l.getCustomerId(), 
                                l.getAmount(), l.getInterestRate());
                System.out.printf("  Tenure: %d months | EMI: ₹%.2f | Status: %s%n",
                                 l.getTenure(), l.getMonthlyPayment(), l.getStatus());
            });
        }
    }
}
