<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SecureBank Management System</title>
    <!-- Bootstrap CSS via CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome via CDN -->
    <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
    <style>
        body {
            background: linear-gradient(135deg, #667eea, #764ba2);
            min-height: 100vh;
            color: #333;
            font-family: 'Inter', sans-serif;
        }
        header {
            background-color: #1a237e;
            color: white;
            padding: 1rem;
            text-align: center;
            font-size: 2rem;
            box-shadow: 0 4px 6px rgba(0,0,0,0.3);
        }
        nav {
            background-color: #283593;
            padding: 1rem;
            display: flex;
            justify-content: center;
            gap: 1rem;
            flex-wrap: wrap;
        }
        nav button {
            background: linear-gradient(45deg, #3d5afe, #304ffe);
            border: none;
            padding: 0.7rem 1.5rem;
            color: white;
            font-weight: bold;
            border-radius: 50px;
            transition: transform 0.2s, box-shadow 0.2s;
        }
        nav button:hover {
            transform: scale(1.05);
            box-shadow: 0 4px 10px rgba(0,0,0,0.3);
        }
        .section-content {
            max-width: 600px;
            margin: 2rem auto;
            background: white;
            padding: 2rem;
            border-radius: 15px;
            box-shadow: 0 0 15px rgba(0,0,0,0.3);
        }
        .section-content h2 {
            text-align: center;
            color: #1a237e;
            margin-bottom: 1rem;
        }
        .record-list {
            max-width: 800px;
            margin: 2rem auto;
            background: white;
            padding: 2rem;
            border-radius: 15px;
            box-shadow: 0 0 15px rgba(0,0,0,0.3);
        }
        .record-list h3 {
            color: #1a237e;
            margin-top: 1rem;
            border-bottom: 2px solid #eee;
            padding-bottom: 0.5rem;
        }
        .balance-positive {
            color: #2e7d32;
            font-weight: bold;
        }
        .balance-negative {
            color: #c62828;
            font-weight: bold;
        }
        .account-card {
            border-left: 4px solid #3d5afe;
            padding-left: 1rem;
            margin-bottom: 1rem;
        }
        .transaction-item {
            transition: all 0.2s ease;
        }
        .transaction-item:hover {
            transform: translateX(4px);
            background-color: #f8f9fa;
        }
    </style>
</head>
<body>
    <header>
        <i class="fas fa-university"></i> SecureBank Management System
    </header>

    <nav>
        <button onclick="showSection('customerSection')"><i class="fas fa-user-tie"></i> Register Customer</button>
        <button onclick="showSection('accountSection')"><i class="fas fa-piggy-bank"></i> Open Account</button>
        <button onclick="showSection('transactionSection')"><i class="fas fa-exchange-alt"></i> Process Transaction</button>
        <button onclick="showSection('loanSection')"><i class="fas fa-hand-holding-usd"></i> Apply for Loan</button>
        <button onclick="showSection('displaySection')"><i class="fas fa-list"></i> View Records</button>
    </nav>

    <div class="section-content" id="customerSection">
        <h2>Register New Customer</h2>
        <form id="customerForm">
            <input class="form-control mb-3" type="text" id="customerName" placeholder="Full Name" required>
            <input class="form-control mb-3" type="number" id="customerAge" placeholder="Age" min="18" required>
            <select class="form-select mb-3" id="customerGender" required>
                <option value="">Select Gender</option>
                <option>Male</option>
                <option>Female</option>
                <option>Other</option>
            </select>
            <input class="form-control mb-3" type="text" id="customerPhone" placeholder="Phone (10 digits)" required>
            <input class="form-control mb-3" type="email" id="customerEmail" placeholder="Email" required>
            <input class="form-control mb-3" type="text" id="customerAddress" placeholder="Address" required>
            <input class="form-control mb-3" type="text" id="customerIdProof" placeholder="Government ID Number" required>
            <button class="btn btn-success w-100" type="submit">Register Customer</button>
        </form>
    </div>

    <div class="section-content" id="accountSection" style="display: none;">
        <h2>Open New Account</h2>
        <form id="accountForm">
            <input class="form-control mb-3" type="number" id="accountCustomerId" placeholder="Customer ID" required>
            <select class="form-select mb-3" id="accountType" required>
                <option value="">Select Account Type</option>
                <option>Savings Account</option>
                <option>Current Account</option>
                <option>Fixed Deposit</option>
                <option>Recurring Deposit</option>
            </select>
            <input class="form-control mb-3" type="number" id="accountInitialDeposit" placeholder="Initial Deposit (Minimum ₹1000)" min="1000" required>
            <div id="fdFields" style="display: none;">
                <select class="form-select mb-3" id="fdTenure">
                    <option value="">Select Tenure</option>
                    <option value="3">3 Months (5.5%)</option>
                    <option value="6">6 Months (6.0%)</option>
                    <option value="12">1 Year (6.5%)</option>
                    <option value="24">2 Years (7.0%)</option>
                    <option value="36">3 Years (7.5%)</option>
                </select>
            </div>
            <button class="btn btn-primary w-100" type="submit">Open Account</button>
        </form>
    </div>

    <div class="section-content" id="transactionSection" style="display: none;">
        <h2>Process Transaction</h2>
        <form id="transactionForm">
            <input class="form-control mb-3" type="number" id="transactionAccountId" placeholder="Account Number" required>
            <select class="form-select mb-3" id="transactionType" required>
                <option value="">Select Transaction Type</option>
                <option>Deposit</option>
                <option>Withdrawal</option>
                <option>Transfer</option>
            </select>
            <input class="form-control mb-3" type="number" id="transactionAmount" placeholder="Amount" min="1" required>
            <div id="transferFields" style="display: none;">
                <input class="form-control mb-3" type="number" id="transactionTargetAccount" placeholder="Target Account Number">
            </div>
            <textarea class="form-control mb-3" id="transactionRemarks" placeholder="Remarks"></textarea>
            <button class="btn btn-warning w-100" type="submit">Process Transaction</button>
        </form>
    </div>

    <div class="section-content" id="loanSection" style="display: none;">
        <h2>Loan Application</h2>
        <form id="loanForm">
            <input class="form-control mb-3" type="number" id="loanCustomerId" placeholder="Customer ID" required>
            <select class="form-select mb-3" id="loanType" required>
                <option value="">Select Loan Type</option>
                <option>Personal Loan</option>
                <option>Home Loan</option>
                <option>Car Loan</option>
                <option>Education Loan</option>
            </select>
            <input class="form-control mb-3" type="number" id="loanAmount" placeholder="Loan Amount" min="10000" required>
            <select class="form-select mb-3" id="loanTenure" required>
                <option value="">Select Tenure</option>
                <option value="12">1 Year</option>
                <option value="24">2 Years</option>
                <option value="36">3 Years</option>
                <option value="60">5 Years</option>
                <option value="120">10 Years</option>
            </select>
            <button class="btn btn-danger w-100" type="submit">Apply for Loan</button>
        </form>
    </div>

    <div class="record-list" id="displaySection" style="display: none;">
        <h2>Bank Records</h2>
        <h3>Customers</h3>
        <ul id="customerList" class="list-group"></ul>
        <h3>Accounts</h3>
        <ul id="accountList" class="list-group"></ul>
        <h3>Transactions</h3>
        <ul id="transactionList" class="list-group"></ul>
        <h3>Loans</h3>
        <ul id="loanList" class="list-group"></ul>
    </div>

    <script>
        let customers = [];
        let accounts = [];
        let transactions = [];
        let loans = [];
        let customerIdCounter = 100001;
        let accountIdCounter = 500001;
        let transactionIdCounter = 900001;
        let loanIdCounter = 700001;

        // Interest rates for different account types
        const interestRates = {
            'Savings Account': 3.5,
            'Current Account': 0.5,
            'Fixed Deposit': 6.5, // Base rate, actual depends on tenure
            'Recurring Deposit': 5.5
        };

        // Loan interest rates
        const loanInterestRates = {
            'Personal Loan': 10.5,
            'Home Loan': 8.5,
            'Car Loan': 9.0,
            'Education Loan': 7.5
        };

        function showSection(sectionId) {
            document.querySelectorAll('.section-content, .record-list').forEach(section => section.style.display = 'none');
            document.getElementById(sectionId).style.display = 'block';
        }

        // Customer registration
        document.getElementById('customerForm').addEventListener('submit', function(e) {
            e.preventDefault();
            const name = document.getElementById('customerName').value;
            const age = document.getElementById('customerAge').value;
            const gender = document.getElementById('customerGender').value;
            const phone = document.getElementById('customerPhone').value;
            const email = document.getElementById('customerEmail').value;
            const address = document.getElementById('customerAddress').value;
            const idProof = document.getElementById('customerIdProof').value;

            if (!/^\d{10}$/.test(phone)) {
                alert('Phone number must be exactly 10 digits.');
                return;
            }
            if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
                alert('Invalid email address.');
                return;
            }

            const customer = { 
                id: customerIdCounter++, 
                name, 
                age, 
                gender, 
                phone, 
                email, 
                address, 
                idProof,
                joinDate: new Date().toISOString()
            };
            customers.push(customer);
            alert(Customer Registered! Customer ID: ${customer.id});
            this.reset();
        });

        // Account type change handler
        document.getElementById('accountType').addEventListener('change', function() {
            const fdFields = document.getElementById('fdFields');
            fdFields.style.display = this.value === 'Fixed Deposit' ? 'block' : 'none';
        });

        // Transaction type change handler
        document.getElementById('transactionType').addEventListener('change', function() {
            const transferFields = document.getElementById('transferFields');
            transferFields.style.display = this.value === 'Transfer' ? 'block' : 'none';
        });

        // Account opening
        document.getElementById('accountForm').addEventListener('submit', function(e) {
            e.preventDefault();
            const customerId = parseInt(document.getElementById('accountCustomerId').value);
            const accountType = document.getElementById('accountType').value;
            const initialDeposit = parseFloat(document.getElementById('accountInitialDeposit').value);
            const fdTenure = document.getElementById('fdTenure').value;

            const customer = customers.find(c => c.id === customerId);
            if (!customer) {
                alert('Invalid Customer ID');
                return;
            }

            if (accountType === 'Fixed Deposit' && !fdTenure) {
                alert('Please select tenure for Fixed Deposit');
                return;
            }

            let interestRate = interestRates[accountType];
            if (accountType === 'Fixed Deposit') {
                interestRate = 5.5 + (parseInt(fdTenure) * 0.5);
            }

            const account = {
                id: accountIdCounter++,
                customerId,
                type: accountType,
                balance: initialDeposit,
                interestRate,
                openingDate: new Date().toISOString(),
                status: 'Active',
                fdTenure: accountType === 'Fixed Deposit' ? fdTenure : null,
                fdMaturity: accountType === 'Fixed Deposit' ? 
                    new Date(Date.now() + parseInt(fdTenure) * 30 * 24 * 60 * 60 * 1000).toISOString() : null
            };

            accounts.push(account);
            
            transactions.push({
                id: transactionIdCounter++,
                accountId: account.id,
                type: 'Deposit',
                amount: initialDeposit,
                balance: initialDeposit,
                date: new Date().toISOString(),
                remarks: 'Initial deposit for account opening'
            });

            alert(Account Opened Successfully! Account Number: ${account.id});
            this.reset();
            document.getElementById('fdFields').style.display = 'none';
        });

        // Process transaction
        document.getElementById('transactionForm').addEventListener('submit', function(e) {
            e.preventDefault();
            const accountId = parseInt(document.getElementById('transactionAccountId').value);
            const transactionType = document.getElementById('transactionType').value;
            const amount = parseFloat(document.getElementById('transactionAmount').value);
            const targetAccount = document.getElementById('transactionTargetAccount').value;
            const remarks = document.getElementById('transactionRemarks').value;

            const account = accounts.find(a => a.id === accountId);
            if (!account) {
                alert('Invalid Account Number');
                return;
            }

            if (account.type === 'Fixed Deposit' && transactionType !== 'Deposit') {
                const maturityDate = new Date(account.fdMaturity);
                if (new Date() < maturityDate) {
                    alert(Withdrawals not allowed from Fixed Deposit before maturity on ${maturityDate.toLocaleDateString()});
                    return;
                }
            }

            if (transactionType === 'Withdrawal' && account.balance < amount) {
                alert('Insufficient funds');
                return;
            }

            if (transactionType === 'Transfer') {
                const targetAcc = accounts.find(a => a.id === parseInt(targetAccount));
                if (!targetAcc) {
                    alert('Invalid Target Account Number');
                    return;
                }
                if (account.balance < amount) {
                    alert('Insufficient funds for transfer');
                    return;
                }
                
                account.balance -= amount;
                targetAcc.balance += amount;
                
                transactions.push({
                    id: transactionIdCounter++,
                    accountId: account.id,
                    type: 'Transfer Out',
                    amount: amount,
                    balance: account.balance,
                    date: new Date().toISOString(),
                    remarks: Transfer to A/C ${targetAccount}: ${remarks}
                });
                
                transactions.push({
                    id: transactionIdCounter++,
                    accountId: targetAcc.id,
                    type: 'Transfer In',
                    amount: amount,
                    balance: targetAcc.balance,
                    date: new Date().toISOString(),
                    remarks: Transfer from A/C ${account.id}: ${remarks}
                });
                
                alert(Transfer of ₹${amount} successful to A/C ${targetAccount});
            } else {
                if (transactionType === 'Deposit') {
                    account.balance += amount;
                } else {
                    account.balance -= amount;
                }
                
                transactions.push({
                    id: transactionIdCounter++,
                    accountId: account.id,
                    type: transactionType,
                    amount: amount,
                    balance: account.balance,
                    date: new Date().toISOString(),
                    remarks: remarks || ${transactionType} transaction
                });
                
                alert(${transactionType} of ₹${amount} successful);
            }
            
            this.reset();
            document.getElementById('transferFields').style.display = 'none';
        });

        // Loan application
        document.getElementById('loanForm').addEventListener('submit', function(e) {
            e.preventDefault();
            const customerId = parseInt(document.getElementById('loanCustomerId').value);
            const loanType = document.getElementById('loanType').value;
            const loanAmount = parseFloat(document.getElementById('loanAmount').value);
            const loanTenure = parseInt(document.getElementById('loanTenure').value);

            const customer = customers.find(c => c.id === customerId);
            if (!customer) {
                alert('Invalid Customer ID');
                return;
            }

            const interestRate = loanInterestRates[loanType];
            const monthlyPayment = calculateEMI(loanAmount, interestRate, loanTenure);

            const loan = {
                id: loanIdCounter++,
                customerId,
                type: loanType,
                amount: loanAmount,
                interestRate,
                tenure: loanTenure,
                monthlyPayment,
                startDate: new Date().toISOString(),
                statusthe
            };

            loans.push(loan);
            alert(Loan Application Submitted! Loan ID: ${loan.id}\nEstimated EMI: ₹${monthlyPayment.toFixed(2)});
            this.reset();
        });

        // Calculate EMI
        function calculateEMI(principal, annualRate, tenureMonths) {
            const monthlyRate = (annualRate / 12) / 100;
            return principal * monthlyRate * Math.pow(1 + monthlyRate, tenureMonths) / 
                   (Math.pow(1 + monthlyRate, tenureMonths) - 1);
        }

        // Display all records
        function displayRecords() {
            const customerList = document.getElementById('customerList');
            const accountList = document.getElementById('accountList');
            const transactionList = document.getElementById('transactionList');
            const loanList = document.getElementById('loanList');

            customerList.innerHTML = customers.map(c => `
                <li class="list-group-item">
                    <div class="d-flex justify-content-between">
                        <div>
                            <strong>ID:</strong> ${c.id}<br>
                            <strong>Name:</strong> ${c.name}<br>
                            <strong>Phone:</strong> ${c.phone}
                        </div>
                        <div>
                            <strong>Joined:</strong> ${new Date(c.joinDate).toLocaleDateString()}<br>
                            <strong>Email:</strong> ${c.email}
                        </div>
                    </div>
                </li>
            `).join('');

            accountList.innerHTML = accounts.map(a => {
                const customer = customers.find(c => c.id === a.customerId);
                return `
                    <li class="list-group-item account-card">
                        <div class="d-flex justify-content-between">
                            <div>
                                <strong>Account No:</strong> ${a.id}<br>
                                <strong>Type:</strong> ${a.type}<br>
                                <strong>Customer:</strong> ${customer ? customer.name : 'Unknown'} (ID: ${a.customerId})
                            </div>
                            <div class="text-end">
                                <strong>Balance:</strong> <span class="balance-positive">₹${a.balance.toFixed(2)}</span><br>
                                <strong>Interest:</strong> ${a.interestRate}%<br>
                                ${a.fdMaturity ? <strong>Matures:</strong> ${new Date(a.fdMaturity).toLocaleDateString()} : ''}
                            </div>
                        </div>
                    </li>
                `;
            }).join('');

            transactionList.innerHTML = transactions.slice().reverse().slice(0, 50).map(t => {
                const account = accounts.find(a => a.id === t.accountId);
                return `
                    <li class="list-group-item transaction-item">
                        <div class="d-flex justify-content-between">
                            <div>
                                <strong>${t.type}</strong><br>
                                <small>${new Date(t.date).toLocaleString()}</small><br>
                                ${account ? <small>A/C: ${account.id} (${account.type})</small> : ''}
                            </div>
                            <div class="text-end">
                                <strong class="${t.type.includes('Deposit') || t.type.includes('In') ? 'balance-positive' : 'balance-negative'}">
                                    ${t.type.includes('Deposit') || t.type.includes('In') ? '+' : '-'}₹${t.amount.toFixed(2)}
                                </strong><br>
                                <small>Balance: ₹${t.balance.toFixed(2)}</small><br>
                                <small>${t.remarks}</small>
                            </div>
                        </div>
                    </li>
                `;
            }).join('');

            loanList.innerHTML = loans.map(l => {
                const customer = customers.find(c => c.id === l.customerId);
                return `
                    <li class="list-group-item">
                        <div class="d-flex justify-content-between">
                            <div>
                                <strong>Loan ID:</strong> ${l.id}<br>
                                <strong>Type:</strong> ${l.type}<br>
                                <strong>Customer:</strong> ${customer ? customer.name : 'Unknown'} (ID: ${l.customerId})
                            </div>
                            <div class="text-end">
                                <strong>Amount:</strong> ₹${l.amount.toFixed(2)}<br>
                                <strong>EMI:</strong> ₹${l.monthlyPayment.toFixed(2)}<br>
                                <strong>Status:</strong> ${l.status}
                            </div>
                        </div>
                    </li>
                `;
            }).join('');
        }

        // Initialize event listeners
        document.querySelector('nav button:nth-child(5)').addEventListener('click', displayRecords);
        document.getElementById('accountType').addEventListener('change', function() {
            document.getElementById('fdFields').style.display = this.value === 'Fixed Deposit' ? 'block' : 'none';
        });
        document.getElementById('transactionType').addEventListener('change', function() {
            document.getElementById('transferFields').style.display = this.value === 'Transfer' ? 'block' : 'none';
        });

        // Show customer section by default
        showSection('customerSection');
    </script>
</body>
</html>
